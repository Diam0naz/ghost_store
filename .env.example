# NEAR network: mainnet or testnet
NEAR_NETWORK=testnet

# Override RPC endpoint (optional; defaults are set in propose.ts)
# NEAR_RPC_URL=

# Proposer account (function-call key limited to `propose` on the contract)
PROPOSER_ACCOUNT_ID=your-proposer.testnet
PROPOSER_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY

# Treasury contract
TREASURY_CONTRACT_ID=treasury.testnet

# NEAR AI Cloud
NEAR_AI_BASE_URL=https://api.near.ai/v1
NEAR_AI_API_KEY=your-near-ai-api-key
NEAR_AI_MODEL=your-model-id
