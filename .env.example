# NEAR network: mainnet or testnet
NEAR_NETWORK=testnet

# Override RPC endpoint (optional; defaults are set in propose.ts)
# NEAR_RPC_URL=

# Proposer account. Use a function-call key limited to `propose`, `propose_attested` and
# `execute_auto` on the treasury contract (agent/scripts/testnet-v2-setup.mjs proposer-key).
PROPOSER_ACCOUNT_ID=your-proposer.testnet
PROPOSER_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY

# Treasury contract
TREASURY_CONTRACT_ID=treasury.testnet

# NEAR AI Cloud
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=your-near-ai-api-key
# Use a model NEAR AI runs inside its own TEE (owned_by "nearai" in /v1/models). Proxied models
# such as openai/* or anthropic/* would send the merchant's books outside the TEE.
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# ---- Legacy off-chain attestation records (optional) --------------------------
# propose.ts now submits TEE-signed completions with `propose_attested`, which the contract
# verifies on chain. These settings only serve the older off-chain record service.
# Ed25519 private key used to sign proposal attestations. PEM (PKCS#8) or
# base64 PKCS#8 DER. This is an AGENT-HELD key, not a TEE key: it proves the
# agent signed the content, not that inference ran in a TEE. NEVER commit it.
ATTESTATION_SIGNING_KEY=
# Optional PEM public key; derived from the private key when unset.
ATTESTATION_PUBLIC_KEY=
# Free-form provider label stored in the record.
ATTESTATION_PROVIDER=local-agent
# Measured code/image hash, if the deployment exposes one.
ATTESTATION_MEASUREMENT=
# Where the agent PUTs records (run `npm run attestation:serve` in agent/).
# Leave blank to write local files only, with no web-visible record.
ATTESTATION_PUBLISH_URL=http://127.0.0.1:8787
ATTESTATION_PUBLISH_TOKEN=
ATTESTATION_OUTPUT_DIR=./attestations
# Local record service settings.
ATTESTATION_SERVICE_HOST=127.0.0.1
ATTESTATION_SERVICE_PORT=8787
ATTESTATION_SERVICE_TOKEN=

# Keeper (`npm run keeper`): executes autonomy payouts after the veto window and alerts signers
# when one enters it. All optional.
KEEPER_INTERVAL_S=20
# Slack or Discord incoming webhook.
ALERT_WEBHOOK_URL=
# Telegram bot: token from @BotFather, chat id of the signers' chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Link added to alerts so a signer can veto in one tap.
TREASURY_UI_URL=

# Revenue sweep (`npm run sweep`): moves settled checkout revenue from the merchant's
# NEAR Intents balance into a mainnet treasury. Dry run unless `-- --execute`.
MERCHANT_ACCOUNT_ID=
SWEEP_TREASURY_ID=
# Base units to leave in the Intents balance (default 0).
SWEEP_KEEP=
# Only for --execute. Never commit.
MERCHANT_PRIVATE_KEY=
