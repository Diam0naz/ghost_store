# Copy to .env and fill in locally. Never commit real values.

# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
TREASURY_CONTRACT_ID=
# Account used by the AI service. Give it a function-call key limited to `propose` on the treasury.
PROPOSER_ACCOUNT_ID=
PROPOSER_PRIVATE_KEY=

# NEAR AI Cloud (get a key at https://cloud.near.ai). Verify base URL and model in https://docs.near.ai/
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=
NEAR_AI_MODEL=

# NEAR Intents (mainnet only, no testnet). Verify endpoints in https://docs.near-intents.org/
INTENTS_API_URL=
# Optional JWT; without it a 0.2% fee applies
INTENTS_JWT=
