# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_TREASURY_CONTRACT_ID=treasury.YOUR_ACCOUNT.testnet

# NEAR Intents 1Click API (mainnet only — use dry:true for dev)
NEXT_PUBLIC_INTENTS_BASE_URL=https://1click.chaindefuser.com
# JWT from partners — without it a 0.2% fee applies
NEXT_PUBLIC_INTENTS_JWT=

# Where settled funds land: USDC bridged to NEAR via omft (intents balance)
NEXT_PUBLIC_INTENTS_DESTINATION_ASSET=nep141:eth-0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48.omft.near
# Mainnet account credited with the settlement (public intents balance)
# Mainnet NEAR account only — Intents rejects *.testnet with "Internal server error".
NEXT_PUBLIC_INTENTS_RECIPIENT=
# INTENTS (public balance) or CONFIDENTIAL_INTENTS (private, needs signed intents)
NEXT_PUBLIC_INTENTS_RECIPIENT_TYPE=INTENTS

# Treasury stable token (testnet)
NEXT_PUBLIC_STABLE_TOKEN=usdt.fakes.testnet

# Privy app ID — create an app at https://privy.io; when unset the treasury
# login gate falls back to NEAR wallet-selector sign-in
NEXT_PUBLIC_PRIVY_APP_ID=
