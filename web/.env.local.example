# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_TREASURY_CONTRACT_ID=treasury.YOUR_ACCOUNT.testnet

# NEAR Intents 1Click API (mainnet only — use dry:true for dev)
NEXT_PUBLIC_INTENTS_BASE_URL=https://1click.chaindefuser.com
# JWT from partners — without it a 0.2% fee applies
NEXT_PUBLIC_INTENTS_JWT=

# Where settled funds land: USDC bridged to NEAR via omft (intents balance)
NEXT_PUBLIC_INTENTS_DESTINATION_ASSET=
# Mainnet account credited with the settlement (public intents balance)
# Mainnet NEAR account only — Intents rejects *.testnet with "Internal server error".
NEXT_PUBLIC_INTENTS_RECIPIENT=
# INTENTS (public balance) or CONFIDENTIAL_INTENTS (private, needs signed intents)
NEXT_PUBLIC_INTENTS_RECIPIENT_TYPE=INTENTS

# Treasury stable token (testnet)
NEXT_PUBLIC_STABLE_TOKEN=usdt.fakes.testnet

# Yield venues shown on /treasury (comma-separated account ids)
NEXT_PUBLIC_YIELD_VENUES=ghoststore-venue.testnet

# AI proposer account (public, safe to expose). Proposals from this account get
# an AI proof badge; everything else is labelled "Human-proposed".
NEXT_PUBLIC_AI_PROPOSER=ai-proposer.treasury-dev.testnet

# ---- server-only attestation verification ----------------------------------
# Do NOT prefix these with NEXT_PUBLIC_. They are read only by the API route.
# Base URL of the attestation record service (agent: npm run attestation:serve)
ATTESTATION_BASE_URL=
# Optional bearer token for the record service
ATTESTATION_FETCH_TOKEN=
# Comma-separated allow-list of measurement hashes. Empty = "not performed".
EXPECTED_MEASUREMENTS=
# Clock tolerance for issuedAt vs proposal created_at, in ms (default 600000).
ATTESTATION_CLOCK_TOLERANCE_MS=600000

# Factory that creates merchant treasuries (<shop>.<factory>). Enables /onboard and the shop switcher.
NEXT_PUBLIC_FACTORY_CONTRACT_ID=

# Cold vault shown on /vault (docs/COLD-VAULT.md); ?vault=<id> also selects one.
NEXT_PUBLIC_COLD_VAULT_ID=
